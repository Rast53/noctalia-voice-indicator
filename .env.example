# Noctalia Voice Type configuration example
# Copy to ~/.config/noctalia-voice-type/env or export these variables in your session.

# Provider: deepgram today. openai-compatible/openrouter is planned/experimental.
VOICE_TYPE_PROVIDER=deepgram
VOICE_TYPE_LANGUAGE=ru
VOICE_TYPE_STATE_FILE=/tmp/voice-type-state.json
VOICE_TYPE_INSERT_METHOD=wayland-clipboard

# Deepgram
DEEPGRAM_API_KEY=replace-me
DEEPGRAM_MODEL=nova-3

# Future / experimental OpenAI-compatible transcription provider
# OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPAT_API_KEY=replace-me
# OPENAI_COMPAT_MODEL=google/gemini-2.5-flash
