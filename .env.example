# Noctalia Voice Type local configuration example
# Copy to ~/.config/noctalia-voice-type/env or run: noctalia-voice-type init-config
# This file is private. Do not commit real API keys.

VOICE_TYPE_PROVIDER=deepgram
VOICE_TYPE_LANGUAGE=ru
VOICE_TYPE_STATE_FILE=/tmp/voice-type-state.json
VOICE_TYPE_INSERT_METHOD=wayland-clipboard

# F11 long dictation auto-stop: finish after this many seconds of silence.
# Set to 0 to disable auto-stop.
VOICE_TYPE_AUTO_STOP_SILENCE_SECONDS=10
VOICE_TYPE_AUTO_STOP_MIN_RECORD_SECONDS=2
VOICE_TYPE_AUTO_STOP_RMS_THRESHOLD=500

# Deepgram
DEEPGRAM_API_KEY=
# Alternative name also supported:
NOCTALIA_VOICE_TYPE_DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Future / experimental OpenAI-compatible transcription provider
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
