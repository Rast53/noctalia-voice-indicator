{
  "id": "voice-type-indicator",
  "name": "Voice Type Indicator",
  "version": "1.7.0",
  "minNoctaliaVersion": "3.6.0",
  "author": "Raclaw",
  "license": "MIT",
  "description": "Locale-aware Noctalia Voice Type indicator with configurable F11 auto-stop and countdown overlay.",
  "tags": [
    "Bar",
    "Voice",
    "Utility"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "dotScale": 0.38,
      "activeWidthScale": 0.92,
      "idleOpacity": 0.55,
      "recordingColor": "#b86cff",
      "processingColor": "#5da9ff",
      "successColor": "#6be675",
      "errorColor": "#ff6b6b",
      "idleColor": "#6f7480",
      "showIdle": true,
      "pulse": true,
      "visualStyle": "wave",
      "transcription": {
        "provider": "deepgram",
        "model": "nova-3",
        "apiKeys": {},
        "language": "ru"
      },
      "autoStop": {
        "enabled": true,
        "silenceSeconds": 10,
        "minRecordSeconds": 2,
        "rmsThreshold": 500
      }
    }
  },
  "repository": "https://github.com/Rast53/noctalia-voice-indicator"
}
